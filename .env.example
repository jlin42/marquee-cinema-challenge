# Local Postgres from docker-compose.yml (port 5433 avoids clashing with a locally installed Postgres)
DATABASE_URL=postgres://marquee:marquee@localhost:5433/marquee

# How long a seat hold lasts before it lapses (seconds)
HOLD_TTL_SECONDS=480

# The staff admin account created by `npm run db:seed` (sign in at /staff).
# Set these in .env only; never commit real credentials. If the password is empty,
# the seed generates one and prints it.
STAFF_ADMIN_USERNAME=
STAFF_ADMIN_PASSWORD=

# Shared password for the other demo staff accounts (1 more admin, 10 privileged, 30 viewers).
# If empty, the seed generates one and prints it.
STAFF_DEMO_PASSWORD=

# 100%-off discount code for demos and staff comps (created by `npm run db:seed`).
# If empty, the seed generates one and prints it.
COMP_DISCOUNT_CODE=
